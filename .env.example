# For LOCAL runs only. In production these are GitHub Actions repository
# secrets, not a file.
#
#   cp .env.example .env.local
#   node --env-file=.env.local scripts/run.ts --dry
#
# .env.local is gitignored. Never commit real keys.

# SerpApi — the "Google API" giving price_level (low/typical/high),
# typical_price_range and price_history. https://serpapi.com/manage-api-key
SERPAPI_KEY=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=

# Where the digest goes. With no verified domain this MUST be the email
# address on your Resend account — the only one their shared sender may
# deliver to.
EMAIL_TO=atmeltonjr@gmail.com

# Optional. Only if you later verify a domain in Resend, which would also let
# you email your friends directly instead of forwarding.
# EMAIL_FROM=Flight Watch <flights@yourdomain.com>
